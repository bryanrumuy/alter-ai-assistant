# Required
OPENAI_API_KEY=your-openai-api-key

# Optional (defaults shown)
OPENAI_MODEL=gpt-6-luna
# Only set TEMPERATURE for models that accept it (newer models allow the default only)
# TEMPERATURE=0.3
OWNER_NAME=Bryan
# Minutes the bot stays quiet in a chat after you replied by hand
MANUAL_PAUSE_MINUTES=30
# Cron expression for the summary report sent to your own chat
REPORT_CRON=0 * * * *
MAX_HISTORY=15
MAX_REPLIES_PER_MINUTE=5
# Optional: web app that receives each follow-up as JSON (Google Apps Script -> Google Sheets)
# SHEETS_WEBHOOK_URL=
# Optional: file with facts the assistant may use (default knowledge.md)
# KNOWLEDGE_FILE=knowledge.md
# Telegram bot (npm run telegram): token from @BotFather, and your own id from /myid
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_ID=
# Dashboard (npm run dashboard): required password; listens on localhost unless DASHBOARD_HOST is set
# DASHBOARD_PASSWORD=choose-a-long-random-password
# DASHBOARD_PORT=3100
# "personal" answers for you; "business" is a customer-service assistant that answers from knowledge.md
# BOT_MODE=personal
# BUSINESS_NAME=Kopi Senja
